# Copy this file to `.env` and put your real postgres password in it.
# .env is in .gitignore: passwords must NEVER be committed to Git.
# If your password has special characters (@ : / # ?), URL-encode them, e.g. @ -> %40
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/oakline

PORT=3001

# Secret used to SIGN login tokens (JWT). Use a long random string and keep it private:
# anyone who knows it can log in as any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Password for the 4 demo accounts that `npm run db:setup` creates (development only).
DEMO_PASSWORD=Password123!

# The React dev server. Only this origin is allowed to call the API from a browser (CORS).
CLIENT_ORIGIN=http://localhost:5173
